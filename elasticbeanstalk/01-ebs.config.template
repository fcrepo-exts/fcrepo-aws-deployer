#
# A template for a .ebextensions configuration file. Used to mount a volume.
#
# start of Terraform template; the following is autogenerated by Terraform, do not modify
#
commands:
  01detect_device:
    command: |
      # pick the first unmounted nvme disk that is NOT the root
      DEVICE=$(lsblk -ndo NAME,TYPE,MOUNTPOINT \
        | awk '$2=="disk" && $3=="" {print "/dev/"$1}' \
        | grep nvme \
        | head -n1)

      echo "EBS_DEVICE=$DEVICE" > /tmp/ebs-device
      echo "Detected EBS device: $DEVICE"

  02prepare_mountpoint:
    command: |
      source /tmp/ebs-device
      mkdir -p /mnt/fedora-data
      echo "Using device $EBS_DEVICE"

  03format_if_needed:
    command: |
      set -e
      source /tmp/ebs-device

      if [ -z "$EBS_DEVICE" ]; then
        echo "No EBS device found — skipping format"
        exit 0
      fi

      # If the device already has a filesystem, don't try to format
      if blkid "$EBS_DEVICE" >/dev/null 2>&1; then
        echo "$EBS_DEVICE already has a filesystem — skipping mkfs"
        exit 0
      fi

      # Only format if the mountpoint directory is empty
      if find /mnt/fedora-data/ -maxdepth 0 -empty | read v; then
        echo "Formatting $EBS_DEVICE with XFS"
        mkfs.xfs -L fcrepo-data "$EBS_DEVICE"
      else
        echo "/mnt/fedora-data contains data — skipping format"
      fi

  04mount_volume:
    command: |
      mkdir -p /mnt/fedora-data
      mount LABEL=fcrepo-data /mnt/fedora-data || echo "Mount already exists"

  05persist_fstab:
    command: |
      if ! grep -q "LABEL=fcrepo-data" /etc/fstab; then
        echo "LABEL=fcrepo-data  /mnt/fedora-data  xfs  defaults,nofail  0  2" >> /etc/fstab
      fi
      
  06health_check_mount:
  command: |
    echo "[health] Checking mount…"
    if mount | grep -q "/mnt/fedora-data"; then
      echo "[health] OK: volume is mounted."
      df -h /mnt/fedora-data
      exit 0
    else
      echo "[health] ERROR: volume NOT mounted!"
      exit 1
    fi

07show_public_ip:
  command: |
    echo "[info] Public IP:"
    curl -s http://169.254.169.254/latest/meta-data/public-ipv4 || echo "No public IP associated."
